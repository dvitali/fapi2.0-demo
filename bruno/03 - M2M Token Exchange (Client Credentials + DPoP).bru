meta {
  name: 03 - M2M Token Exchange (Client Credentials + DPoP)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/oauth/token
  body: json
  auth: none
}

body:json {
  {
    "grant_type": "client_credentials",
    "client_id": "{{clientId}}",
    "client_assertion_type": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer",
    "client_assertion": "{{clientAssertion}}",
    "scope": "corporate:treasury corporate:payments corporate:fx-rates"
  }
}

headers {
  DPoP: {{dpopProof}}
}

script:pre-request {
  const crypto = require('crypto');

  // 1. Read PLAIN SSL Client Certificate and Private Key from Bruno Environment
  const rawCert = bru.getEnvVar('clientCertificatePem');
  const rawKey = bru.getEnvVar('clientPrivateKeyPem');
  const rawDpopPem = bru.getEnvVar('dpopPrivateKeyPem');
  const rawDpopJwk = bru.getEnvVar('dpopPublicKeyJwk');

  const certPem = rawCert.replace(/\\n/g, '\n');
  const clientPrivateKeyPem = rawKey.replace(/\\n/g, '\n');
  const dpopPrivateKeyPem = rawDpopPem.replace(/\\n/g, '\n');
  const dpopPublicKeyJwk = typeof rawDpopJwk === 'string' ? JSON.parse(rawDpopJwk) : rawDpopJwk;

  // 2. Parse X.509 Certificate and extract DER base64 for 'x5c' header (RFC 7515 §4.1.6)
  const x509 = new crypto.X509Certificate(certPem);
  const derBase64 = x509.raw.toString('base64');
  const certThumbprint = x509.fingerprint256.replace(/:/g, '').toLowerCase();

  // 3. Base64URL encoding helper (RFC 7515 / RFC 7519)
  function base64url(input) {
    if (Buffer.isBuffer(input)) {
      return input.toString('base64url');
    }
    const str = typeof input === 'string' ? input : JSON.stringify(input);
    return Buffer.from(str, 'utf8').toString('base64url');
  }

  // 4. Sign JWT using ES256 (ECDSA P-256 + SHA256)
  function signJwt(header, payload, privateKeyPem) {
    const encHeader = base64url(header);
    const encPayload = base64url(payload);
    const signingInput = encHeader + '.' + encPayload;

    const signature = crypto.sign('SHA256', Buffer.from(signingInput), {
      key: privateKeyPem,
      dsaEncoding: 'ieee-p1363'
    });

    return signingInput + '.' + base64url(signature);
  }

  const targetUrl = bru.getEnvVar('baseUrl') + '/oauth/token';
  const clientId = bru.getEnvVar('clientId');
  const now = Math.floor(Date.now() / 1000);

  // 5. Generate RFC 7523 client_assertion embedding the X.509 Certificate Chain ('x5c')
  const clientAssertion = signJwt(
    {
      typ: 'JWT',
      alg: 'ES256',
      x5c: [derBase64],
      'x5t#S256': certThumbprint
    },
    {
      iss: clientId,
      sub: clientId,
      aud: targetUrl,
      jti: crypto.randomUUID(),
      iat: now,
      exp: now + 300
    },
    clientPrivateKeyPem
  );

  // 6. Generate RFC 9449 DPoP Proof with embedded public JWK
  const dpopProof = signJwt(
    {
      typ: 'dpop+jwt',
      alg: 'ES256',
      jwk: {
        kty: 'EC',
        crv: 'P-256',
        x: dpopPublicKeyJwk.x,
        y: dpopPublicKeyJwk.y
      }
    },
    {
      jti: crypto.randomUUID(),
      htm: 'POST',
      htu: targetUrl,
      iat: now
    },
    dpopPrivateKeyPem
  );

  // Populate variables for Bruno's Body and Headers tabs
  bru.setVar('clientAssertion', clientAssertion);
  bru.setVar('dpopProof', dpopProof);
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar('accessToken', res.getBody().access_token);
  }
}

assert {
  res.status: eq 200
  res.body.token_type: eq DPoP
  res.body.access_token: isDefined
  res.body.dpop_jkt: isDefined
}
