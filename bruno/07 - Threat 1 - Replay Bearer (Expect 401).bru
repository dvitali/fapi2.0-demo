meta {
  name: 07 - Threat 1 - Replay Bearer (Expect 401)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/b2b-api/treasury/positions
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 401
  res.body.error: eq unauthorized
  res.body.message: contains Bearer tokens are prohibited
}
